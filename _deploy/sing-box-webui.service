[Unit]
Description=sing-box WebUI (loopback Go backend and nginx frontend)
After=default.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/apps/sing-box-webui
ExecStart=%h/apps/sing-box-webui/_deploy/start.sh
ExecStop=%h/apps/sing-box-webui/_deploy/stop.sh
TimeoutStartSec=180

[Install]
WantedBy=default.target
